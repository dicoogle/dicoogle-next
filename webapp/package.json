{
  "name": "dicoogle-next",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node FileSystemManagerServer.js",
    "build": "tsc && vite build",
    "preview": "NODE_ENV=production node FileSystemManagerServer.js",
    "build:fs": "npx esbuild FileSystemManagerServer.js --bundle --platform=node --format=cjs --outfile=fs-server-bundle.cjs && pkg fs-server-bundle.cjs --public --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path ./dist/bin",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cornerstonejs/core": "^1.80.5",
    "@cornerstonejs/dicom-image-loader": "^1.80.5",
    "@cornerstonejs/tools": "^1.80.5",
    "chonky": "^2.3.2",
    "chonky-icon-fontawesome": "^2.3.2",
    "clsx": "^2.1.1",
    "cornerstone-core": "^2.6.1",
    "cornerstone-wado-image-loader": "^4.13.2",
    "dicom-parser": "^1.8.21",
    "dicoogle-client": "^5.3.0",
    "express": "^4.21.2",
    "hammerjs": "^2.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.445.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.2",
    "vite-express": "^0.19.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/cornerstone-core": "^2.3.3",
    "@types/express": "^5.0.0",
    "@types/hammerjs": "^2.0.46",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "pkg": "^5.8.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "vite": "^5.4.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
