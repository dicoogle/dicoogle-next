FROM eclipse-temurin:21-jre
WORKDIR /app
COPY dicoogle-next-0.0.1-SNAPSHOT.jar app.jar
CMD java -jar app.jar --spring.profiles.active=dev --server.port=8082 --app.dimse.cstore.enabled=true --app.dimse.cstore.port=11113 --app.dimse.cstore.bind-address=0.0.0.0 --app.dimse.query-retrieve.enabled=true --app.dimse.query-retrieve.port=11114 --app.dimse.query-retrieve.bind-address=0.0.0.0 --app.plugins.startup-validation.require-writable-provider=false --dicoogle.legacy-proxy.enabled=true --dicoogle.legacy-proxy.base-url=http://legacy:8080 --dicoogle.legacy-proxy.auth.username=dicoogle --dicoogle.legacy-proxy.auth.password=dicoogle --dicoogle.legacy-proxy.storage-retrieve-mode=AUTO --dicoogle.legacy-proxy.query-index-mode=AUTO --app.dimse.cmove.destinations.LEGACYSCP.host=legacy --app.dimse.cmove.destinations.LEGACYSCP.port=6666 --app.dimse.cmove.destinations.LEGACYSCP.ae-title=DICOOGLE --app.storage.file-rw.root-dir=/dicoogle-storage --app.storage.file-rw.enabled=false --app.query.lucene.enabled=false --app.query.file.enabled=false
